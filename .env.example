# KLSI 4.0 Environment Configuration
# Copy this file to .env and update with your actual values

# ========================================
# Database Configuration
# ========================================
POSTGRES_USER=klsi_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=klsi_db

# ========================================
# Application Security
# ========================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_me_to_random_secret_key_minimum_32_chars

# ========================================
# Application Environment
# ========================================
ENV=production
PYTHON_GIL=0  # Disable GIL for Python 3.13t
PYTHONPATH=/app

# ========================================
# Application Startup Configuration
# ========================================
# WARNING: Set these to false in production!
RUN_STARTUP_DDL=false  # Use Alembic migrations instead
RUN_STARTUP_SEED=false  # Seed data only in development
I18N_PRELOAD_ENABLED=true  # Preload translations for performance
REGISTRY_AUTO_DISCOVER_ENABLED=false  # Disable plugin auto-discovery
