# Dockerfile.experimental for Python 3.13 Free-Threading (No-GIL)
# Currently, there is no official "python:3.13-nogil" image on Docker Hub.
# This Dockerfile builds Python 3.13 from source with free-threading enabled.

FROM debian:bookworm-slim

ENV PYTHON_VERSION=3.13.0
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# 1. Install build dependencies
RUN apt-get update && apt-get install -y \
    wget \
    build-essential \
    libssl-dev \
    zlib1g-dev \
    libncurses5-dev \
    libnss3-dev \
    libreadline-dev \
    libffi-dev \
    libsqlite3-dev \
    libbz2-dev \
    liblzma-dev \
    libpq-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Rust (needed for pydantic-core)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# 2. Download and build Python 3.13 with --disable-gil
RUN wget https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz \
    && tar -xf Python-${PYTHON_VERSION}.tgz \
    && cd Python-${PYTHON_VERSION} \
    && ./configure --disable-gil --enable-optimizations --with-ensurepip=install \
    && make -j$(nproc) \
    && make install \
    && cd .. \
    && rm -rf Python-${PYTHON_VERSION} Python-${PYTHON_VERSION}.tgz

# 3. Create symlinks for convenience
# python3.13t is the binary name for free-threaded python
RUN ln -s /usr/local/bin/python3.13t /usr/local/bin/python-nogil

WORKDIR /app

# 4. Install dependencies
# Note: Many packages may not have pre-built wheels for cp313t yet.
COPY requirements-nogil.txt .
RUN python3.13t -m pip install --upgrade pip && \
    python3.13t -m pip install --no-cache-dir -r requirements-nogil.txt

# 5. Copy application code
    COPY app ./app
    COPY alembic.ini ./alembic.ini

    EXPOSE 8000

# 6. Run with uvicorn
# Note: Ensure uvicorn is installed in requirements-nogil.txt
CMD ["python3.13t", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
